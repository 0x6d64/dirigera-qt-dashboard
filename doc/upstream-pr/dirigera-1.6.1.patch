diff --git a/tests/test_electrical_sensor.py b/tests/test_electrical_sensor.py
index 48ac4f6..d89d748 100644
--- a/tests/test_electrical_sensor.py
+++ b/tests/test_electrical_sensor.py
@@ -92,3 +92,21 @@ def test_dict_to_electrical_sensor(
     assert sensor.attributes.total_energy_consumed == attributes["totalEnergyConsumed"]
     assert sensor.attributes.total_energy_consumed_last_updated is not None
     assert sensor.attributes.time_of_last_energy_reset is not None
+
+
+def test_reset_energy_counter(
+    fake_electrical_sensor: ElectricalSensor, fake_client: FakeDirigeraHub
+) -> None:
+    fake_electrical_sensor.capabilities.can_receive.append("energyConsumedAtLastReset")
+    fake_electrical_sensor.reset_energy_counter()
+    action = fake_client.patch_actions.pop()
+    assert action["route"] == f"/devices/{fake_electrical_sensor.id}"
+    assert action["data"] == [{"attributes": {"energyConsumedAtLastReset": 0}}]
+
+
+def test_reset_energy_counter_needs_capability(
+    fake_electrical_sensor: ElectricalSensor, fake_client: FakeDirigeraHub
+) -> None:
+    with pytest.raises(AssertionError):
+        fake_electrical_sensor.reset_energy_counter()
+    assert not fake_client.patch_actions
diff --git a/tests/test_light.py b/tests/test_light.py
index 3b40518..d721305 100644
--- a/tests/test_light.py
+++ b/tests/test_light.py
@@ -462,3 +462,26 @@ def test_dict_to_light_3rdparty(fake_client: FakeDirigeraHub) -> None:
     assert light.attributes.model == data["attributes"]["model"]
     assert light.attributes.manufacturer == data["attributes"]["manufacturer"]
     assert light.attributes.serial_number == data["attributes"]["serialNumber"]
+
+
+def test_leave_adaptive_profile(
+    fake_light: Light, fake_client: FakeDirigeraHub
+) -> None:
+    fake_light.activate_adaptive_profile(PROFILE_ID)
+    fake_client.patch_actions.clear()
+    fake_light.leave_adaptive_profile()
+    action = fake_client.patch_actions.pop()
+    assert action["route"] == f"/devices/{fake_light.id}"
+    assert action["data"] == [{"adaptiveProfile": {"id": PROFILE_ID, "active": False}}]
+    assert fake_light.adaptive_profile == AdaptiveProfileState()
+
+
+def test_leave_adaptive_profile_does_nothing_outside_adaptive_mode(
+    fake_light: Light, fake_client: FakeDirigeraHub
+) -> None:
+    # the hub did not report a profile
+    fake_light.leave_adaptive_profile()
+    # the hub reported an empty profile
+    fake_light.adaptive_profile = AdaptiveProfileState()
+    fake_light.leave_adaptive_profile()
+    assert not fake_client.patch_actions
