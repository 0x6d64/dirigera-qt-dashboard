diff --git a/src/dirigera/devices/electrical_sensor.py b/src/dirigera/devices/electrical_sensor.py
index 847fb36..e12c40a 100644
--- a/src/dirigera/devices/electrical_sensor.py
+++ b/src/dirigera/devices/electrical_sensor.py
@@ -32,6 +32,21 @@ class ElectricalSensor(Device):
         self.dirigera_client.patch(route=f"/devices/{self.id}", data=data)
         self.attributes.custom_name = name
 
+    def reset_energy_counter(self) -> None:
+        """
+        Restarts the "since last reset" count: the hub stores the current
+        total_energy_consumed as energy_consumed_at_last_reset and sets
+        time_of_last_energy_reset to now. total_energy_consumed itself never resets.
+        Call reload() to see the new values.
+        """
+        if "energyConsumedAtLastReset" not in self.capabilities.can_receive:
+            raise AssertionError(
+                "This device does not support the energyConsumedAtLastReset capability"
+            )
+
+        data = [{"attributes": {"energyConsumedAtLastReset": 0}}]
+        self.dirigera_client.patch(route=f"/devices/{self.id}", data=data)
+
 
 def dict_to_electrical_sensor(
     data: Dict[str, Any], dirigera_client: AbstractSmartHomeHub
diff --git a/src/dirigera/devices/light.py b/src/dirigera/devices/light.py
index c2cb931..7a25f44 100644
--- a/src/dirigera/devices/light.py
+++ b/src/dirigera/devices/light.py
@@ -130,6 +130,20 @@ class Light(Device):
         self.dirigera_client.patch(route=f"/devices/{self.id}", data=data)
         self.adaptive_profile = AdaptiveProfileState(id=profile_id, active=True)
 
+    def leave_adaptive_profile(self) -> None:
+        """
+        Takes the lamp out of adaptive mode. Level and on/off state stay as they are.
+        Does nothing if the lamp is not known to follow a profile, call reload()
+        first if its state may be out of date.
+        """
+        profile = self.adaptive_profile
+        if profile is None or not profile.active or profile.id is None:
+            return
+
+        data = [{"adaptiveProfile": {"id": profile.id, "active": False}}]
+        self.dirigera_client.patch(route=f"/devices/{self.id}", data=data)
+        self.adaptive_profile = AdaptiveProfileState()
+
 
 def dict_to_light(data: Dict[str, Any], dirigera_client: AbstractSmartHomeHub) -> Light:
     return Light(
