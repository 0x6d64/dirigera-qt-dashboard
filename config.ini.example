# Example configuration file for Dirigera Qt Dashboard
# Copy this file to config.ini next to dashboard.py (the app reads it from
# there, whatever directory you start it from) and fill in your details
# DO NOT commit config.ini to version control!

[hub]
# Your Dirigera hub IP address
ip_address = 192.168.1.100

# Your authentication token (keep this secret!)
# Generate using: uv run python generate_token.py <hub_ip>
token = YOUR_TOKEN_HERE

# Optional: limit or tune the "Discover" network scan. Every key is optional.
[discovery]
# Comma-separated networks (CIDR) to scan instead of the automatically detected
# local ones. Scans stop at 4096 addresses in total.
# networks = 192.168.1.0/24
# Number of addresses probed in parallel (1-500, default 50)
# max_workers = 50
# Seconds to wait for each address (0.1-30, default 1.0)
# timeout = 1.0

# Optional: the price used for the cost of energy use on the Energy tab.
# Defaults: Romania, March 2026, residential price including network costs and
# taxes (1.54 RON per kWh).
[energy]
# Price per kWh (above 0 and up to 100; a comma is accepted as the decimal sign)
# price_per_kwh = 1.54
# Currency label shown after the cost (1-8 characters)
# currency = RON
